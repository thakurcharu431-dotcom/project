    "# print(\"================================================================\")\n",
    "print(\"          SMARTCAMPUS UTILITY & ACCESS PASS GENERATOR          \")\n",
    "print(\"================================================================\")\n",
    "import sys\n",
    "user=int(input(\"Select User Category \"))\n",
    "base=0\n",
    "merit=0\n",
    "parking=0\n",
    "sur=0\n",
    "if user==1:\n",
    "    a=input(\"Enter Sub-Category\")\n",
    "    x=\"UG\"\n",
    "    y=\"PG\"\n",
    "    if a==x:\n",
    "        base=500\n",
    "        \n",
    "    elif a==y:\n",
    "        base=350\n",
    "        \n",
    "    else:\n",
    "        sys.exit(\"Error\")\n",
    "elif user==2:\n",
    "    a=input(\"Enter Sub-Category\")\n",
    "    x=\"resident faculty\"\n",
    "    y=\"guest faculty\"\n",
    "    if a==x:\n",
    "        base=800\n",
    "        \n",
    "    elif a==y:\n",
    "        base=1200\n",
    "        \n",
    "    else:\n",
    "        sys.exit(\"Error\")\n",
    "       \n",
    "else:\n",
    "    sys.exit(\"Error: wrong category\")\n",
    "    \n",
    "if user==1:\n",
    "    cgpa=float(input(\"Enter Student CGPA\"))\n",
    "    if cgpa>=8.5 and cgpa<=10:\n",
    "        merit=base*0.20\n",
    "        \n",
    "    elif cgpa>7.49 and cgpa<8.5:\n",
    "        merit=base*0.10\n",
    "        \n",
    "    elif cgpa<7.5 and cgpa>=0:\n",
    "        merit=0\n",
    "        \n",
    "    else:\n",
    "        sys.exit(\"Error\")\n",
    "        \n",
    "if user==2:\n",
    "    year=float(input(\"enter your working years\"))\n",
    "    if year>10:\n",
    "        merit=base*0.15\n",
    "        \n",
    "    elif year<0:\n",
    "        sys.exit(\"error\")\n",
    "    else:\n",
    "        merit=0\n",
    "        \n",
    "        \n",
    "vehicle=int(input(\"Select Parking Permit\"))\n",
    "if user==1:\n",
    "    if vehicle==2:\n",
    "        sur=0\n",
    "        parking=200\n",
    "       \n",
    "    elif vehicle==4:\n",
    "        sur=150\n",
    "        parking=600\n",
    "        \n",
    "    elif vehicle==0:\n",
    "        parking=0\n",
    "        sur=0\n",
    "        \n",
    "    else:\n",
    "        sys.exit(\"Error\")\n",
    "        \n",
    "elif user==2:\n",
    "    if vehicle==2:\n",
    "        sur=0\n",
    "        parking=200\n",
    "       \n",
    "    elif vehicle==4:\n",
    "        sur=0\n",
    "        parking=600\n",
    "       \n",
    "        \n",
    "    elif vehicle==0:\n",
    "        parking=0\n",
    "        sur=0\n",
    "        \n",
    "    else:\n",
    "        sys.exit(\"Error\")\n",
    "    \n",
    "units=int(input(\"n term your unit\"))\n",
    "if units>=0 and units<=100:\n",
    "    rate=units*3+50\n",
    "    ch=50\n",
    "    \n",
    "elif units>100 and units<=300:\n",
    "    rate=units*5+100\n",
    "    ch=100\n",
    "    \n",
    "elif units>300 and units<=500:\n",
    "    rate=units*7.50+150\n",
    "    ch=150\n",
    "    \n",
    "elif units>500:\n",
    "    rate=units*10+250\n",
    "    ch=250\n",
    "else:\n",
    "    sys.exit(\"Error\")\n",
    "    \n",
    "print(\"----------------------------------------------------------------\")\n",
    "print(\"                     CALCULATED INVOICE BREAKDOWN                \")\n",
    "print(\"----------------------------------------------------------------\")\n",
    "print(\"Base Access Pass Fee       : \",base)\n",
    "print(\"Merit Discount        :-\",merit)\n",
    "print(\"Parking Fee : \",parking)\n",
    "print(\"Student Peak Surcharge     : \",sur)\n",
    "print(\"Net Pass & Parking Total   : \",parking+sur-merit+base)\n",
    "print(\"----------------------------------------------------------------\")\n",
    "print(\"Electricity Bill   : \",rate)\n",
    "print(\"----------------------------------------------------------------\")\n",
    "print(\"TOTAL MONTHLY PAYABLE      : \",base-merit+parking+sur+rate)\n",
    "print(\"================================================================\")"
